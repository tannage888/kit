{
  "expo": {
    "name": "Kit",
    "slug": "kit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.kit.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "kit",
    "experiments": {
      "typedRoutes": true
    }
  }
}
