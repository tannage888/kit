# Kit Gateway — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase (Kit backend) ──────────────────────────────────
SUPABASE_URL=https://your-kit-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Supabase (Open Brain — separate instance) ──────────────
OPEN_BRAIN_URL=https://your-openbrain-project.supabase.co
OPEN_BRAIN_SERVICE_KEY=eyJ...your-openbrain-service-role-key

# ── Anthropic (Claude API for summarisation) ────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key

# ── Gateway settings ────────────────────────────────────────
PORT=3141
# Inactivity window before auto-capture triggers (minutes)
CAPTURE_INACTIVITY_MINUTES=30

# ── Dedicated claude_whatsapp_integration daemon ────────────
# Kit runs its own dedicated WhatsApp daemon on 3142 (main daemon uses 3100).
EXTERNAL_GATEWAY_URL=http://127.0.0.1:3142

# ── Sweep scheduler ─────────────────────────────────────────
SWEEP_INTERVAL_HOURS=3
SWEEP_INITIAL_LOOKBACK_DAYS=7
SWEEP_MAX_MESSAGES_PER_CONTACT=500
SWEEP_CONVERSATION_GAP_HOURS=8
